# ──────────────────────────────────────────────────────────────
#  SIGNUM-CLOCK · ZKTeco TA Push Connector Configuration Example
# ──────────────────────────────────────────────────────────────

# Port for the HTTP/HTTPS connector server to listen on
PORT=5000

# Supabase database configuration (obtain from Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# MUST use the service_role key to bypass Row Level Security (RLS) for server writes
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: secret key to authenticate push requests from the device
# If configured on the device (as the communication password/key), the server will validate it.
# Leave blank or omit if not using device communication passwords.
ZK_PUSH_SECRET=
